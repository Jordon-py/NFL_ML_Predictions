# Frontend environment template for Vite.
# Do not put secrets here. VITE_* values are available to browser code.

# Used by npm run dev and by local npm run preview when served from localhost.
VITE_API_DEV=http://127.0.0.1:8000

# Used by deployed production builds.
VITE_API_BASE_URL=https://nfl-predict-ecf5a5bd34fe.herokuapp.com

VITE_API_TIMEOUT_MS=12000
VITE_PREMIUM_API_TIMEOUT_MS=180000
VITE_API_RETRY_ATTEMPTS=1

# Optional: set true when you intentionally want a local preview build to call
# the deployed backend instead of VITE_API_DEV.
VITE_FORCE_PROD_API=false
