                "ollama/Ollama/deepseek-v3.2:cloud",
                "ollama/Ollama gemma/deepseek-v4-flash:cloud",
                "ollama/Ollama/deepseek-v4-flash:cloud",
                "ollama/Ollama gemma/deepseek-v4-pro:cloud",
                "ollama/Ollama/deepseek-v4-pro:cloud",
                "ollama/Ollama gemma/dolphin-mistral:7b-v2.8-fp16",
