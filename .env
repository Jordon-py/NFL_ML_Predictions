# Environment variables for NFL_ML_Predictions
# Copy to .env and adjust values before running locally
# For Heroku deployment, set these in Heroku Config Vars

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Data Paths (optional overrides - defaults in main.py)
DATASET_PATH=backend/data/Nfl_data_sorted.csv
SCHEDULE_PATH=backend/data/Nfl_schedule_2025_2026.csv

# Logging Configuration
LOG_LEVEL=INFO

# Production Settings (Heroku automatically sets these)
# DYNO=web.1
# WEB_CONCURRENCY=4

# Optional: Database URL (if you add PostgreSQL later)
# DATABASE_URL=postgresql://user:password@localhost:5432/nfl_predictions

# Optional: Redis URL (if you add caching later)
# REDIS_URL=redis://localhost:6379

# Development vs Production
ENVIRONMENT=production
# Set to 'production' on Heroku

# API Configuration
CORS_ORIGINS=http://localhost:3000,https://nfl-predict-ecf5a5bd34fe.herokuapp.com,https://nfl-ml-predictions.vercel.app
# For production, specify exact origins: https://your-app.herokuapp.com
