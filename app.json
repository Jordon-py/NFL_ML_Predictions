{
  "name": "NFL ML Predictions API",
  "description": "NFL Game Prediction System using Machine Learning with FastAPI backend",
  "repository": "https://github.com/Jordon-py/NFL_ML_Predictions",
  "logo": "https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/svg/1f3c8.svg",
  "keywords": ["nfl", "machine-learning", "predictions", "fastapi", "python"],
  "stack": "heroku-22",
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "formation": {
    "web": {
      "quantity": 6,
      "size": "eco"
    }
  },
  "env": {
    "LOG_LEVEL": {
      "description": "Logging level for the application",
      "value": "INFO",
      "required": false
    },
    "ENABLE_ADMIN": {
      "description": "Expose admin-only endpoints like /admin/reload (disable in production)",
      "value": "false",
      "required": false
    },
    "DATA_DIR": {
      "description": "Directory containing game_features_*.csv datasets (relative to backend/)",
      "value": "data/datasets",
      "required": false
    },
    "DATASET_PATH": {
      "description": "Path to NFL dataset CSV file",
      "value": "game_features_20260109_clean.csv",
      "required": false
    },
    "SCHEDULE_PATH": {
      "description": "Path to NFL schedule CSV file", 
      "value": "Nfl_schedule_2025.csv",
      "required": false
    }
  },
  "addons": [],
  "scripts": {
    "postdeploy": "echo 'NFL Prediction API deployed successfully!'"
  },
  "environments": {
    "test": {
      "addons": [],
      "scripts": {
        "test": "pytest tests/ -v"
      }
    }
  }
}
