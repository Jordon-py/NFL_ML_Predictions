# Heroku slugignore (FastAPI backend)
# Keep backend code + required model/data artifacts; exclude dev/frontend cruft.

# Frontend (deployed separately on Vercel)
frontend/

# Node modules
node_modules/
**/node_modules/

# Local Python environments
.venv/
venv/
backend/.venv/
backend/venv/
env/
ENV/

# Git/CI/editor metadata
.git/
.github/
.vscode/
.idea/

# Local env files / secrets
.env
.env.*

# Python caches & test junk
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.cache/

# Notebooks, docs, reports
docs/
reports/
backend/reports/
backend/metrics/
backend/tests/
tests/
**/*.ipynb
**/*.map

# Vercel artifacts
.vercel/
frontend/.vercel/

# Large duplicate artifacts not needed at runtime (we use backend/data/prod-models by default)
models/
backend/OUTDIR/

backend/prod-models/
backend/models/
