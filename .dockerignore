# .dockerignore - Exclude files from Docker builds
# Reduces build context size and improves build speed

# Git
.git/
.github/
.gitignore

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Virtual environments
.env
.venv/
.venv-*/
venv/
ENV/
env/

# Development tools
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
backend/logs/*.log

# Documentation
*.md
!README.md

# Development files
requirements-dev.txt
.pre-commit-config.yaml

# Frontend (if not needed in backend container)
frontend/
node_modules/

# Large data files (may need to be included depending on deployment strategy)
# backend/data/*.csv
# backend/models/*.pkl
# backend/models/*.joblib