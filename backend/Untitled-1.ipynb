   "source": [
    "import pandas as pd\n",
    "from sklearn.cluster import AffinityPropagation\n",
    "import numpy as np\n",
    "\n",
    "pd.set_option('display.max_columns', None)\n",
    "pd.set_option('display.width', 1000)\n",
    "pd.set_option('display.max_rows', 1000)\n",
    "\n",
    "\n",
    "# 1. Load the dataset prep for clustering\n",
    "# Ensure path compatibility\n",
    "df = pd.read_csv('backend/game_features_2014_2025.csv')\n",
    "print(f\"Columns: {df.columns.tolist()}\")\n",
    "df.info(verbose=True)\n",
    "\n",
    "# Drop rows with missing results (future games) to avoid NaN errors\n",
    "df = df.dropna(axis=0, subset=['home_win'])\n",
    "\n",
    "# Convert home_win to binary (0/1)\n",
    "# .astype(int) efficiently converts boolean True/False to 1/0\n",
    "df['home_win'] = df['home_win'].astype(int)\n",
    "\n",
    "df = df.convert_dtypes()\n",
    "y = df['home_win'].to_numpy()\n",
    "X = df.select_dtypes(include=[np.number]).drop(columns=['home_win']).to_numpy()\n",
    "\"\"\"\n",
    "# Get metrics (descriptive statistics)\n",
    "print(\"Data Metrics:\")\n",
    "print(df.describe())\n",
    "df.describe().to_csv('backend/data_metrics_full.csv')\n",
    "df.describe().to_json('backend/data_metrics_full.json')\n",
    "\n",
    "Data_Metrics = df.describe().to_dict()\n",
    "pd.DataFrame(Data_Metrics).to_csv('backend/data_metrics.csv')\n",
    "df['home_win'] = df['home_win'].astype(int)\n",
    "\n",
    "print(f'DATA home_win values: {df[\"home_win\"].unique()}')\n",
    "print(f'Data Types sample: {df.dtypes.head()}')\n",
    "\"\"\"\n"
   ]
  },
  {
   "cell_type": "code",
