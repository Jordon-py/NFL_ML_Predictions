    "                if away_team == logo_row['abbr']:\n",
    "                    away_abbr = logo_row['abbr']\n",
    "                    away_logo = logo_row['logo_url']\n",
    "                    away_team = logo_row['team_name']\n",
    "\n",
    "\n",
    "            games.append(\n",
    "                {\n",
    "                    \"season\": season_val,\n",
    "                    \"week\": week_val,\n",
    "                    \"home_team\": home_team,\n",
    "                    \"away_team\": away_team,\n",
    "                    \"home_abbr\": home_abbr,\n",
    "                    \"away_abbr\": away_abbr,\n",
