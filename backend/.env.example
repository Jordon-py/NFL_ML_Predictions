APP_ENV=development
LOG_LEVEL=INFO

# Ollama integration.
# For direct Ollama Cloud API access, set OLLAMA_API_KEY and use a cloud model.
# The Python SDK host is https://ollama.com; it appends /api itself.
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_API_KEY=
OLLAMA_BASE_URL="https://ollama.com,http://localhost:11434"
OLLAMA_TIMEOUT_S=300

SERVE_FRONTEND=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://new-nfl-predict.vercel.app
ALLOW_VERCEL_PREVIEWS=true
CORS_ORIGINS_REGEX=(?i)^https://(?:[a-z0-9-]+\.)+vercel\.app$
RESTRICT_CORS=true

TEAM_LOGOS_PATH=backend/data/team_logos.csv
SCHEDULE_PATH=backend/data/Nfl_schedule_2026.csv
MODELS_DIR=backend/models
PREDICTIONS_DIR=backend/Predictions
DATABASE_URL=sqlite:///backend/predictions.db

ALLOW_FALLBACK_PREDICTIONS=false
NODE_ENV=development
HP_N_ITER=30
RANDOM_SEED=42
N_SPLITS=5
N_JOBS=-1
MC_SIMS=1000
OFFLINE_MODE=false
ENABLE_ADMIN=false
ADMIN_TOKEN=
