# Runtime mode
APP_ENV=development
LOG_LEVEL=INFO

# CORS
# Keep RESTRICT_CORS=true in production and configure ALLOWED_ORIGINS explicitly.
RESTRICT_CORS=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://new-nfl-predict.vercel.app
CORS_ORIGINS_REGEX=(?i)^https://(?:[a-z0-9-]+\.)+vercel\.app$
ALLOW_VERCEL_PREVIEWS=true

# Data/model locations (optional; auto-discovery is supported)
DATASET_PATH=backend/data/game_features_latest.csv
SCHEDULE_PATH=backend/data/Nfl_schedule_2025.csv
MODELS_DIR=backend/models

# Predict cache
PREDICT_CACHE_TTL_SEC=900
PREDICT_CACHE_MAX_ITEMS=1000

# Admin endpoints
ENABLE_ADMIN=false
ADMIN_TOKEN=

