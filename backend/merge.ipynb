    "# A comprehensive map to group specific player positions into high-level categories.\n",
    "# This simplifies feature engineering and improves model interpretability.\n",
    "position_group_map = {\n",
    "    # --- Offense ---\n",
    "    'QB': 'Offense',\n",
    "    'RB': 'Offense',\n",
    "    'WR': 'Offense',\n",
    "    'TE': 'Offense',\n",
    "    'FB': 'Offense',\n",
    "    'C': 'Offense',\n",
    "    'G': 'Offense',\n",
