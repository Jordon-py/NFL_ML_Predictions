    "\n",
    "# -------------------------------------------------------------------\n",
    "# Logging\n",
    "# -------------------------------------------------------------------\n",
    "\n",
    "logging.basicConfig(\n",
    "    level=logging.INFO,\n",
    "    format=\"[%(asctime)s] [%(levelname)s] %(message)s\",\n",
    ")\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------\n",
    "# Config & Paths\n",
    "# -------------------------------------------------------------------\n",
    "\n",
    "BASE_DIR = Path(__file__).parent.resolve()\n",
    "\n",
    "# Load backend/.env no matter where uvicorn is launched from (project root vs backend/)\n",
    "load_dotenv(BASE_DIR / \".env\")\n",
