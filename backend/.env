SERVE_FRONTEND="false"
# NOTE: Origins must match the browser Origin exactly (no trailing slashes).
# Keep localhost + 127.0.0.1 variants for local dev.
CORS_ORIGINS="https://nfl-ml-predictions.vercel.app,https://nfl-predict-christopher-jordons-projects.vercel.app,https://nfl-predict-git-main-christopher-jordons-projects.vercel.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"
ALLOWED_ORIGINS="https://nfl-ml-predictions.vercel.app,https://nfl-predict-christopher-jordons-projects.vercel.app,https://nfl-predict-git-main-christopher-jordons-projects.vercel.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

TEAM_LOGOS_PATH="backend/data/team_logos.csv"
SCHEDULE_PATH="backend/data/Nfl_schedule_2025.csv"
MODELS_DIR="backend/20251215/models/"
PREDICTIONS_DIR="backend/predictions/"
DATABASE_URL="sqlite:///backend/database/nfl_predictions.db"
ALLOW_FALLBACK_PREDICTIONS="False"
CORS_ORIGINS_REGEX="https://.*\\.vercel\\.app$"
NODE_ENV="production"
HP_N_ITER="40"
RANDOM_SEED="4211"
N_SPLITS="5"
N_JOBS="-1"
RESTRICT_CORS="true"
DATASET_PATH="./data/game_features_20251215.csv"
TRAIN_DATASET_FILE="./data/game_features_20251215.csv"
ENV="backend/.env"
