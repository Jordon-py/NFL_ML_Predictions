# Runtime mode
APP_ENV=development
LOG_LEVEL=INFO


SERVE_FRONTEND="false"
# NOTE: Origins must match the browser Origin exactly (no trailing slashes).
# Keep localhost + 127.0.0.1 variants for local dev.
ALLOWED_ORIGINS="https://new-nfl-predict.vercel.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173"
ALLOW_VERCEL_PREVIEWS="True"

TEAM_LOGOS_PATH="backend/data/team_logos.csv"
SCHEDULE_PATH="data/Nfl_schedule_2025.csv"
MODELS_DIR="data/models"
PREDICTIONS_DIR="backend/predictions/"
DATABASE_URL="sqlite:///backend/database/nfl_predictions.db"
ALLOW_FALLBACK_PREDICTIONS="False"
CORS_ORIGINS_REGEX="(?i)^https://(?:[a-z0-9-]+\\.)+vercel\\.app$"
NODE_ENV="development"
HP_N_ITER="40"
RANDOM_SEED="4211"
N_SPLITS="5"
N_JOBS="-1"
RESTRICT_CORS="True"
# Leave dataset selection unset by default so training and serving follow
# backend/data/datasets/latest_dataset.json. Set either variable explicitly
# only when you intentionally need to override the promoted dataset.
DEFAULT_DATA_DIR="data/datasets"
MC_SIMS="2000"
OFFLINE_MODE="false"
ENABLE_ADMIN="False"
